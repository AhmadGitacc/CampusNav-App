# ─── Supabase ──────────────────────────────────────────────────────────────────
# Project settings → API in the Supabase dashboard.
# These two are bundled into the client and are safe to expose (RLS protects data).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Postgres (server only — NEVER expose to the client) ───────────────────────
# Transaction pooler: use for the serverless/Express runtime.
# Project settings → Database → Connection string → URI (port 6543).
DATABASE_URL=postgres://postgres.your-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Direct connection: use for `npm run db:push` / drizzle-kit migrations.
DIRECT_URL=postgres://postgres:your-password@db.your-ref.supabase.co:5432/postgres

# ─── App / hosting ─────────────────────────────────────────────────────────────
# Deploy host used by lib/query-client.ts to build API URLs (Replit/Cloud Run).
EXPO_PUBLIC_DOMAIN=your-deployment-domain

PORT=5000
